generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  username       String          @default("")
  hashedPassword String?
  name           String?
  emailVerified  DateTime?
  image          String?
  roastEnabled   Boolean         @default(true)
  termsVersion   String          @default("")
  termsAcceptedAt DateTime?
  createdAt      DateTime        @default(now())
  recipes        Recipe[]
  cookedLogs     CookedLog[]
  friendshipsA   Friendship[]    @relation("FriendA")
  friendshipsB   Friendship[]    @relation("FriendB")
  receivedShares RecipeShare[]
  recipeTakes    RecipeTake[]
  recipeComments RecipeComment[]
  accounts       Account[]
  sessions       Session[]
  recipeReviews  RecipeReview[]
  contentTranslations ContentTranslation[]
  nativeSessions NativeSession[]
  friendInvites FriendInvite[]
  nativeScans NativeScan[]
  blockedUsers UserBlock[] @relation("Blocker")
  blockedBy UserBlock[] @relation("Blocked")
  reports ContentReport[]
  nativeSubscription NativeSubscription?
  chefRoasts ChefRoast[]
  syncReceipts NativeSyncReceipt[]
  kitchenState NativeKitchenState[]
  mealKitchens MealKitchen[]
  mealMemberships MealMember[]
  mealProfiles MealProfile[]
  mealPosts MealPost[]
  privateMealMedia MealMedia[]
}

model MealKitchen {
  id String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  version Int @default(0)
  state Json
  members MealMember[]
  profiles MealProfile[]
  posts MealPost[]
  receipts MealReceipt[]
  media MealMedia[]
}
model MealMedia {
  kitchenId String
  occasionId String
  actorId String
  photo Bytes
  kitchen MealKitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
  @@id([kitchenId, occasionId])
}
model MealMember {
  kitchenId String
  userId String
  role String
  kitchen MealKitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([kitchenId, userId])
}
model MealProfile {
  id String @id
  kitchenId String
  managerId String
  version Int @default(1)
  data Json
  kitchen MealKitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  manager User @relation(fields: [managerId], references: [id], onDelete: Cascade)
  @@index([kitchenId])
}
model MealReceipt {
  kitchenId String
  operationId String
  actorId String
  digest String
  response Json
  createdAt DateTime @default(now())
  kitchen MealKitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  @@id([kitchenId, operationId])
}
model MealPost {
  id String @id
  kitchenId String
  authorId String
  occasionId String
  caption String
  rating Int?
  photo Bytes?
  recipeId String?
  createdAt DateTime @default(now())
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kitchen MealKitchen @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  reactions MealReaction[]
  @@index([authorId, createdAt, id])
}
model MealReaction {
  postId String
  userId String
  post MealPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
}

model NativeSyncReceipt {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  operationId String
  digest String
  response Json
  createdAt DateTime @default(now())
  @@id([userId, operationId])
}

model NativeKitchenState {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  id String
  payload String
  updatedAt DateTime @default(now()) @updatedAt
  @@id([userId, kind, id])
}

model Recipe {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  altTitle    String          @default("")
  imageUrl    String          @default("")
  servings    Int
  vibe        String          @default("cozy")
  roastLine   String          @default("")
  translations Json          @default("{}")
  ingredients Json
  sourceProvenance Json?
  steps       Json
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  cookedLogs  CookedLog[]
  shares      RecipeShare[]
  takes       RecipeTake[]
  comments    RecipeComment[]
  reviews     RecipeReview[]
  chefRoasts ChefRoast[]

  @@index([userId, createdAt])
}

model NativeSubscription {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  tokenCipher String
  state String
  expiresAt DateTime
  verifiedAt DateTime @default(now())
}

model ChefRoast {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  text String @default("")
  language String
  step Int
  createdAt DateTime @default(now())
  @@id([userId, recipeId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// JWT sessions remain in use; these standard adapter models retain compatibility.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One editable review per other chef; ratings are constrained to 1–5 in SQL.
model RecipeReview {
  id        String   @id @default(cuid())
  recipeId  String
  authorId  String
  rating    Int
  text      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([recipeId, authorId])
  @@index([authorId])
}

// Contributions belong to the original recipe, even if sharing later ends.
model RecipeTake {
  id         String          @id @default(cuid())
  recipeId   String
  authorId   String
  title      String
  type       String          @default("other")
  change     String
  ingredient String          @default("")
  reason     String          @default("")
  createdAt  DateTime        @default(now())
  recipe     Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  author     User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments   RecipeComment[]

  @@index([recipeId, createdAt])
  @@index([authorId])
}

model RecipeComment {
  id        String      @id @default(cuid())
  recipeId  String
  authorId  String
  takeId    String?
  text      String
  createdAt DateTime    @default(now())
  recipe    Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  take      RecipeTake? @relation(fields: [takeId], references: [id], onDelete: Cascade)

  @@index([recipeId, createdAt])
  @@index([takeId])
  @@index([authorId])
}

model CookedLog {
  id       String   @id @default(cuid())
  userId   String
  recipeId String
  date     DateTime @db.Date
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId, date])
  @@index([userId, date])
}

// Shared database-backed rate limits work across Vercel function instances.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime
}

// One canonical row per pair prevents duplicate and crossed friend requests.
model Friendship {
  id          String        @id @default(cuid())
  userAId     String
  userBId     String
  requesterId String
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())
  userA       User          @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User          @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)
  shares      RecipeShare[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

// Removing a friendship revokes its shares atomically via cascading deletion.
model RecipeShare {
  id           String     @id @default(cuid())
  recipeId     String
  recipientId  String
  friendshipId String
  createdAt    DateTime   @default(now())
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipient    User       @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  friendship   Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)

  @@unique([recipeId, recipientId])
  @@index([recipientId, createdAt])
  @@index([friendshipId])
}

// Immutable, account-scoped translations are reused across recipes and contributions.
model ContentTranslation {
  key String @id
  userId String
  locale String
  source String @db.Text
  text String @db.Text
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model NativeSession {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  authenticatedAt DateTime @default(now())
  tokens NativeRefreshToken[]
  @@index([userId])
}

model NativeRefreshToken {
  hash String @id
  sessionId String
  session NativeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt DateTime?
  @@index([sessionId])
}

model NativeAuthAttempt {
  id String @id @default(cuid())
  state String
  challenge String
  redirect String
  expiresAt DateTime
  codeHash String? @unique
  userId String?
  consumedAt DateTime?
}

model FriendInvite {
  hash String @id
  inviterId String
  inviter User @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  redeemedBy String?
  redeemedAt DateTime?
  @@index([inviterId])
}

// No images retained. A DB reservation prevents concurrent duplicate provider calls.
model NativeScan {
  key String @id
  digest String
  expiresAt DateTime
  result Json?
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model UserBlock {
  blockerId String
  blockedId String
  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model ContentReport {
  id String @id @default(cuid())
  reporterId String
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  recipeId String?
  reportedUserId String?
  reason String
  status String @default("open")
  createdAt DateTime @default(now())
  @@index([status, createdAt])
  @@index([reporterId])
}
